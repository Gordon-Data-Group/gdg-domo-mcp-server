# Required — full URL of your Domo instance (no trailing slash)
DOMO_INSTANCE_URL=https://yourcompany.domo.com

# Required — developer token from Admin > Security > Access Tokens
DOMO_DEVELOPER_TOKEN=your_developer_token_here

# --- Multiple instances (alternative to the two variables above) ---------
# DOMO_INSTANCES=prod,sandbox
# DOMO_DEFAULT_INSTANCE=prod
# DOMO_PROD_INSTANCE_URL=https://yourcompany.domo.com
# DOMO_PROD_DEVELOPER_TOKEN=...
# DOMO_SANDBOX_INSTANCE_URL=https://yourcompany-sandbox.domo.com
# DOMO_SANDBOX_DEVELOPER_TOKEN=...
# DOMO_SANDBOX_READ_ONLY=0   # per-instance override of DOMO_READ_ONLY
# Every tool then takes an `instance` argument naming one of the aliases.

# Optional — defaults to "1" (read-only). Tools that create, update, or
# delete Domo data are neither registered nor reachable at the HTTP layer
# until you explicitly set this to "0".
# DOMO_READ_ONLY=1

# Optional — defaults to "0". When "1", the server starts with only two
# tools — list_toolsets and enable_toolset — instead of every tool for
# every resource group. Call enable_toolset("datasets") (etc.) to register
# a group's tools on demand, keeping the tool list small and cheap.
# DOMO_DYNAMIC_TOOLSETS=0

# Optional — comma-separated toolset names to pre-register at startup even
# under DOMO_DYNAMIC_TOOLSETS=1, e.g. "datasets,cards,users". Ignored
# unless DOMO_DYNAMIC_TOOLSETS=1.
# DOMO_DEFAULT_TOOLSETS=

# Optional — defaults to "50000". Tool results longer than this many
# characters are cut off with a note asking the model to narrow the request.
# "0" disables the cap.
# DOMO_MAX_RESPONSE_CHARS=50000

# Optional — defaults to "1". Null-valued fields are dropped from tool
# results to save tokens; set to "0" to keep them.
# DOMO_STRIP_NULLS=1
