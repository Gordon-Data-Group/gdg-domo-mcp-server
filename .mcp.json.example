{
  "mcpServers": {
    "domo": {
      "command": "domo-mcp-server",
      "env": {
        "DOMO_INSTANCES": "prod,sandbox",
        "DOMO_DEFAULT_INSTANCE": "prod",
        "DOMO_PROD_INSTANCE_URL": "https://[INSTANCE].domo.com",
        "DOMO_PROD_DEVELOPER_TOKEN": "[DOMO-DEVELOPER-TOKEN]",
        "DOMO_SANDBOX_INSTANCE_URL": "https://[SANDBOX-INSTANCE].domo.com",
        "DOMO_SANDBOX_DEVELOPER_TOKEN": "[DOMO-DEVELOPER-TOKEN]",
        "DOMO_DYNAMIC_TOOLSETS": "1",
        "DOMO_DEFAULT_TOOLSETS": "datasets,cards,pages"
      }
    }
  }
}
